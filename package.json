{
  "name": "nabda-api-saas",
  "version": "0.1.0",
  "private": true,
  "author": "Nabda Project",
  "description": "Multi-tenant transactional messaging API SaaS",
  "type": "module",
  "main": "desktop-dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "vercel:build": "node scripts/build-vercel-static.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:free": "tsx --env-file=.env src/db/provision-free.ts",
    "db:device-agent": "tsx --env-file=.env src/db/provision-device-agent.ts",
    "android:build:simulation": "cd android-agent && ./gradlew --no-daemon testSimulationDebugUnitTest lintSimulationDebug assembleSimulationDebug",
    "android:install:simulation": "sh scripts/install-android-simulation.sh",
    "android:smoke:simulation": "node scripts/device-agent-smoke.mjs",
    "build:desktop": "tsc -p tsconfig.desktop.json && node scripts/copy-desktop-assets.mjs",
    "dev:desktop": "npm run build:desktop && electron .",
    "test:desktop": "vitest run tests/desktop*.test.ts",
    "dist:dir": "npm run build:desktop && electron-builder --dir",
    "dist:win": "npm run test:desktop && npm run build:desktop && electron-builder --win nsis --x64",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fontsource-variable/cairo": "^5.3.0",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.nabda.desktop",
    "productName": "Nabda Desktop",
    "icon": "build/icon.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nabda-Desktop-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
