{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "desktop",
    "outDir": "desktop-dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "desktop/main.ts",
    "desktop/controller/**/*.ts",
    "desktop/core/database.ts",
    "desktop/core/migrations.ts",
    "desktop/core/repository.ts",
    "desktop/core/types.ts"
  ],
  "exclude": ["desktop-dist", "node_modules"]
}
