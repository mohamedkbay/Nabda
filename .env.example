# انسخ الملف إلى .env وولّد القيم محليًا. لا توجد أسرار افتراضية هنا.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

POSTGRES_DB=nabda
POSTGRES_USER=nabda
POSTGRES_PASSWORD=
DATABASE_URL=
DB_POOL_MAX=10
# اتركها فارغة عند الاتصال المباشر. أضف فقط CIDRs لوكلاء reverse proxy الموثوقين.
TRUSTED_PROXY_CIDRS=
REDIS_URL=redis://127.0.0.1:6379

# pepper عشوائي طويل (مثال: openssl rand -base64 48).
API_KEY_HASH_SECRET=
# مفتاح base64 يفك إلى 32 بايت بالضبط (مثال: openssl rand -base64 32).
APP_ENCRYPTION_KEY=

# الإرسال الحقيقي محجوب افتراضيًا، حتى لو ضُبطت بيانات مزود.
PROVIDER_MODE=mock
ENABLE_LIVE_SMS=false
HTTPSMS_API_BASE=https://api.httpsms.com/v1
PROVIDER_TIMEOUT_MS=15000
DISPATCH_MIN_INTERVAL_MS=3000
STATUS_POLL_INTERVAL_MS=10000
CLEANUP_INTERVAL_MS=3600000
CLEANUP_BATCH_SIZE=500

QUEUE_PREFIX=nabda
RATE_LIMIT_FAIL_OPEN=false
IP_REQUESTS_PER_MINUTE=1200
API_KEY_REQUESTS_PER_MINUTE=600
ORGANIZATION_WRITES_PER_MINUTE=60
WEBHOOK_TIMEOUT_MS=10000

SEED_ORG_NAME=شركة تجريبية
SEED_ORG_SLUG=demo
SEED_ADMIN_EMAIL=admin@example.invalid

# بيانات مؤسسة تجربة محلية مستقلة. لا تستخدم بيانات أشخاص حقيقيين في Mock.
FREE_ORG_NAME=Local Free Organization
FREE_ORG_SLUG=local-free
FREE_ADMIN_EMAIL=free@example.invalid
