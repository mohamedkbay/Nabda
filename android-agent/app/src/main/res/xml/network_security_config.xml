<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android XML cannot express RFC 1918 CIDRs. ServerUrlPolicy strictly validates
         a literal private IPv4 address before any connection is opened. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
