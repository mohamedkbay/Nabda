# PUBLIC deployment coordinates only. Copy to ignored .env.deploy.
# Never put GITHUB_CLIENT_SECRET or account/API tokens in this file.
NABDA_WORKER_NAME=nabda-api
NABDA_D1_DATABASE_NAME=nabda-api
NABDA_D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_UUID
NABDA_API_ORIGIN=https://YOUR_WORKER.YOUR_SUBDOMAIN.workers.dev
NABDA_WEBSITE_ORIGIN=https://YOUR_SITE.netlify.app
NABDA_GITHUB_CLIENT_ID=REPLACE_WITH_YOUR_GITHUB_OAUTH_CLIENT_ID
# Optional, only for a separate locally registered OAuth App. --preview always
# uses loopback URLs and an isolated database, ignoring production coordinates.
# NABDA_PREVIEW_GITHUB_CLIENT_ID=YOUR_SEPARATE_LOCAL_CLIENT_ID
